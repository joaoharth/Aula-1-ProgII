package arrays;

import java.util.Random;

public class Exercicio6 {

    public static void main(String[] args) {
        Random r = new Random();
        int quantidadeZero = 0;
        int quantidadeUm = 0;

        for (int i = 0; i < 1000; i++) {
            int numero = r.nextInt(2);
            if (numero == 0) {
                quantidadeZero++;
            } else {
                quantidadeUm++;
            }
        }

        double porcentagemZero = quantidadeZero * 100.0 / 1000;
        double porcentagemUm = quantidadeUm * 100.0 / 1000;
        System.out.println("Quantidade de 0: " + quantidadeZero);
        System.out.println("Porcentagem de 0: " + porcentagemZero + "%");
        System.out.println("Quantidade de 1: " + quantidadeUm);
        System.out.println("Porcentagem de 1: " + porcentagemUm + "%");
    }


		
		

	}


